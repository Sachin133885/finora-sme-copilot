PORT=3000
FINORA_DB=./data/finora.sqlite
# Enable only behind an actual HTTPS reverse proxy.
FINORA_HTTPS=0
# Optional OCR language; install matching Tesseract language data.
FINORA_OCR_LANG=chi_sim+eng
# Optional server-side tool-capable LLM; never put secrets in the HTML.
LLM_ENDPOINT=https://YOUR_PROVIDER_HOST/v1/chat/completions
LLM_MODEL=YOUR_MODEL
LLM_API_KEY=YOUR_SERVER_ONLY_KEY
